import java.io.Serializable;

public class Students implements Printable, Savable, Serializable {

    // ------------------ Static Field ------------------
    private static int totalStudents;

    static {
        totalStudents = 0;
        System.out.println("Student system has been initialized...");
    }

    // ------------------ Instance Fields ------------------
    private int id;
    private String name;
    private int age;
    private String location;
    private String course;
    private int year;

    // ------------------ Constructor ------------------
    public Students(String name, int age, String location, String course, int year) throws InvalidAgeException {
        setName(name);
        setAge(age);
        setLocation(location);
        setCourse(course);
        setYear(year);

        totalStudents++;
        this.id = generateID(); // Automatically to generate student ID
    }

    // ------------------ Static Methods ------------------
    public static int generateID() {
        return 1000 + totalStudents; // IDs numbers will start at 1001
    }

    // ------------------ Setters ------------------
    public void setName(String name) {
        this.name = name;
    }

    public void setAge(int age) throws InvalidAgeException {
        if (age < 18) {
            throw new InvalidAgeException("Age must be 18 or above!");
        }
        this.age = age;
    }

    public void setLocation(String location) {
        this.location = location;
    }

    public void setCourse(String course) {
        this.course = course;
    }

    public void setYear(int year) {
        this.year = year;
    }

    // ------------------ Getters ------------------
    public int getId() {
        return id;
    }

    public String getName() {
        return name;
    }

    public int getAge() {
        return age;
    }

    public String getLocation() {
        return location;
    }

    public String getCourse() {
        return course;
    }

    public int getYear() {
        return year;
    }

    // ------------------ Printable Interface ------------------
    @Override
    public void print() {
        System.out.println("--------------------------------------------");
        System.out.println("Student ID   : " + id);
        System.out.println("Name         : " + name);
        System.out.println("Age          : " + age);
        System.out.println("Location     : " + location);
        System.out.println("Course       : " + course);
        System.out.println("Participant Year: " + year);
        System.out.println("--------------------------------------------");
    }

    // ------------------ Savable Interface ------------------
    @Override
    public void saveToFile() {
        System.out.println("Student " + name + " is ready to be saved to file.");
    }
}
